{
  "name": "motor-co",
  "version": "0.1.0",
  "private": true,
  "description": "Motor de modelos y flujos: React + Laravel",
  "workspaces": [
    "apps/web",
    "apps/e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @motor-co/web --if-present",
    "dev:api": "cd apps/api && php artisan serve --host=127.0.0.1 --port=8001",
    "test": "npm run test:api && npm run test:web",
    "test:api": "cd apps/api && php artisan test",
    "test:web": "npm run test --workspace @motor-co/web --if-present",
    "lint": "npm run lint:api && npm run lint:web",
    "lint:api": "cd apps/api && php vendor/bin/pint --test",
    "lint:web": "npm run lint --workspace @motor-co/web --if-present",
    "typecheck": "npm run typecheck --workspace @motor-co/web --if-present",
    "build": "npm run build --workspace @motor-co/web --if-present"
  }
}
